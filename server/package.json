{
  "name": "syncpad-server",
  "version": "1.0.0",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/syncpad_test} JWT_SECRET=${JWT_SECRET:-test-secret-key} jest --forceExit --detectOpenHandles --runInBand",
    "test:coverage": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/syncpad_test} JWT_SECRET=${JWT_SECRET:-test-secret-key} jest --forceExit --detectOpenHandles --runInBand --coverage",
    "lint": "eslint src/ tests/",
    "db:init": "node src/config/init-db.js"
  },
  "keywords": [],
  "author": "Aryan Kumar Singh",
  "license": "ISC",
  "description": "Backend for SyncPad collaborative code editor with Yjs CRDT sync",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lib0": "^0.2.99",
    "morgan": "^1.10.1",
    "pg": "^8.21.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  }
}
